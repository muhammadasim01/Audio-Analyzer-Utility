NODE_ENV=development
PORT=3001

# Production database
DATABASE_URL=postgresql://postgres:password@localhost:5432/audio_service

# Test database (used by integration tests)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/audio_service_test

# Max upload file size in bytes (default: 50MB)
MAX_FILE_SIZE_BYTES=52428800

# Directory for uploaded files (relative to backend/)
UPLOAD_DIR=uploads
